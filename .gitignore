# Xcode
build/
DerivedData/
*.xcuserstate
*.xcscmblueprint
xcuserdata/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
*.swp
*~

# CocoaPods (if used)
Pods/

# Carthage (if used)
Carthage/Build/

# Cursor/IDE (but keep commands tracked)
.cursor/*
!.cursor/commands/

# Development notes (local only, not for public repo)
dev-notes/

# Build logs
build-*.txt

# Coverage reports (generated files in workspace root)
coverage.json
coverage-report.txt
coverage-summary.md

# Auto-generated website stats
docs/download-stats.json

# DMG files (should only exist in GitHub Releases)
*.dmg

# Hidden scripts with credentials (never commit!)
hidden_scripts/

# Backup files
*.bak

# Build artifacts (precautionary)
*.zip
*.pkg

# Agent-generated plan files (keep code_signing.md and todo.md)
plans/*.plan.md

# Cursor worktree config (machine-specific paths)
.cursorworktrees.json

# Claude local settings (per-developer)
.claude/settings.local.json

# WebRTC XCFramework (built locally or in CI)
Muesli/Frameworks/webrtc_audio_processing.xcframework/
Muesli/Frameworks/*.sha256
