{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Cursor worktree configuration for automatic app identity setup",
  "version": "1.0",
  "worktrees": {
    "ayb": {
      "suffix": "ayb",
      "branch": "bugfix/onboarding-bypass",
      "bundleId": "com.muesli.app.ayb",
      "productName": "Muesli-ayb"
    },
    "esk": {
      "suffix": "esk",
      "branch": "esk-resume-recording-feature",
      "bundleId": "com.muesli.app.esk",
      "productName": "Muesli-esk"
    },
    "hve": {
      "suffix": "hve",
      "branch": "feature/aec-file-output-and-timestamp-fix",
      "bundleId": "com.muesli.app.hve",
      "productName": "Muesli-hve"
    },
    "kxn": {
      "suffix": "kxn",
      "branch": "feature/transcript-enhancement",
      "bundleId": "com.muesli.app.kxn",
      "productName": "Muesli-kxn"
    },
    "lxa": {
      "suffix": "lxa",
      "branch": "lxa-transcript-refinement-optimization",
      "bundleId": "com.muesli.app.lxa",
      "productName": "Muesli-lxa"
    },
    "vmr": {
      "suffix": "vmr",
      "branch": "refactor/viewmodel-god-object",
      "bundleId": "com.muesli.app.vmr",
      "productName": "Muesli-vmr"
    },
    "wpy": {
      "suffix": "wpy",
      "branch": "resume-recording-feature",
      "bundleId": "com.muesli.app.wpy",
      "productName": "Muesli-wpy"
    }
  },
  "templates": {
    "bundleIdPattern": "com.muesli.app.{suffix}",
    "productNamePattern": "Muesli-{suffix}",
    "tccCommands": [
      "tccutil reset ScreenCapture com.muesli.app.{suffix}",
      "tccutil reset Microphone com.muesli.app.{suffix}",
      "defaults delete com.muesli.app.{suffix}"
    ]
  },
  "projectFile": "Muesli.xcodeproj/project.pbxproj",
  "replacements": {
    "bundleId": {
      "find": "PRODUCT_BUNDLE_IDENTIFIER = com.muesli.app;",
      "replaceWith": "PRODUCT_BUNDLE_IDENTIFIER = com.muesli.app.{suffix};"
    },
    "productName": {
      "find": "PRODUCT_NAME = \"$(TARGET_NAME)\";",
      "replaceWith": "PRODUCT_NAME = \"Muesli-{suffix}\";"
    },
    "tccScreenCapture": {
      "find": "tccutil reset ScreenCapture com.muesli.app",
      "replaceWith": "tccutil reset ScreenCapture com.muesli.app.{suffix}"
    },
    "tccMicrophone": {
      "find": "tccutil reset Microphone com.muesli.app",
      "replaceWith": "tccutil reset Microphone com.muesli.app.{suffix}"
    },
    "tccDefaults": {
      "find": "defaults delete com.muesli.app",
      "replaceWith": "defaults delete com.muesli.app.{suffix}"
    }
  }
}
